# Copy this file to .env and fill in the two values. Both are public by design.
# Find them in Supabase: Project Settings > API.
# NEVER put the service-role key or the Paystack secret key here. Those only go in `supabase secrets set`.
VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
